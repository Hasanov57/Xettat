{
  "manifest_version": 3,
  "name": "Xəttat — Azərbaycan hərfləri",
  "short_name": "Xəttat",
  "version": "0.1.0",
  "description": "İngilis klaviaturası ilə yazılmış mətni düzgün Azərbaycan yazısına çevirir: seher → səhər. Model brauzerin içində işləyir.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Xəttat",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "contextMenus", "offscreen", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "restore-text": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Aktiv mətn sahəsini Xəttat ilə düzəlt"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
